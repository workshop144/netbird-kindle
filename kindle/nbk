#!/bin/sh
# nbk: NetBird on a jailbroken Kindle, in userspace mode.
#
#   nbk start     bring the link up (enrols on first start if a setup key file is present)
#   nbk stop      take it down and undo every change
#   nbk restart   stop, then start (quicker than waiting after a long sleep)
#   nbk status    say what is running and whether the link answers
#   nbk toggle    start if down, stop if up
#   nbk check     check the settings and change nothing
#   nbk import    take in settings and a setup key left in the netbird-kindle folder on the
#                 Kindle's storage (start, restart and toggle do this first by themselves)
#
# The Kindle's kernel has no TUN driver, so NetBird cannot make a network interface. It runs
# in "netstack" mode instead and offers a SOCKS5 proxy on localhost. Readers such as KOReader
# cannot use SOCKS5, so for each address in FORWARDS a firewall rule redirects that address
# to a local port, where nblink carries the connection through the proxy.
#
# Nothing on the read-only system partition is written. The firewall rules sit in two chains
# of their own and the hosts overlay is a bind mount; `nbk stop` or a reboot removes both.

set -f # no file name expansion anywhere: settings are split into words, never globbed
LC_ALL=C; export LC_ALL # bytes, not characters: the checks below mean exactly what they say

DIR=$(cd "$(dirname "$0")" && pwd -P)
CONF="$DIR/netbird-kindle.conf"
RUN=/var/run/netbird-kindle
KEYFILE="$DIR/setup-key"
DROP=/mnt/us/netbird-kindle
NAT_CHAIN=NBK
IN_CHAIN=NBK-IN
LOG_MAX=262144
WAIT_SECONDS=60

# The settings are a shell file read by root. They live beside this script, out of /mnt/us.
defaults() {
    : "${PEER_NAME:=kindle}" "${SOCKS_PORT:=1080}" "${FIRST_LOCAL_PORT:=14431}"
    : "${FORWARDS:=}" "${HOSTS:=}" "${MANAGEMENT_URL:=}"
}

settings() {
    [ -r "$CONF" ] || return 1
    # shellcheck disable=SC1090
    . "$CONF"
    defaults
}

need_settings() {
    settings && return 0
    echo "nbk: no settings yet. Put netbird-kindle.conf in the netbird-kindle folder on the Kindle's storage."
    exit 2
}

# --- settings are checked before anything is started ---------------------------------------

# A port number written the plain way: digits, no leading zero, 1 to 65535.
is_port() {
    case "$1" in '' | 0* | *[!0-9]*) return 1 ;; esac
    [ ${#1} -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# A plain IPv4 address that is not loopback, unspecified or a network.
is_address() {
    printf '%s\n' "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    old_ifs=$IFS; IFS=.
    # shellcheck disable=SC2086
    set -- $1
    IFS=$old_ifs
    for octet in "$@"; do [ "$octet" -le 255 ] || return 1; done
    [ "$1" -ne 127 ] && [ "$1" -ne 0 ]
}

# One line only: a value with a line break in it is never what was meant.
one_line() { [ "$(printf '%s\n' "$1" | wc -l)" -eq 1 ]; }

validate() {
    if ! is_port "$SOCKS_PORT" || ! is_port "$FIRST_LOCAL_PORT"; then
        echo "nbk: SOCKS_PORT and FIRST_LOCAL_PORT must be port numbers"; return 1
    fi
    if ! one_line "$PEER_NAME" ||
        ! printf '%s\n' "$PEER_NAME" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$'; then
        echo "nbk: PEER_NAME may hold letters, digits, dot, dash and underscore only"; return 1
    fi
    if [ -n "$MANAGEMENT_URL" ]; then
        if ! one_line "$MANAGEMENT_URL" ||
            ! printf '%s\n' "$MANAGEMENT_URL" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$'; then
            echo "nbk: MANAGEMENT_URL does not look like a URL"; return 1
        fi
    fi
    [ -n "$FORWARDS" ] || { echo "nbk: FORWARDS is empty: nothing to carry"; return 1; }
    count=0
    for f in $FORWARDS; do
        if ! is_address "${f%:*}" || ! is_port "${f##*:}"; then
            echo "nbk: FORWARDS entry '$f' must be IP:PORT (IPv4, not loopback, no network)"; return 1
        fi
        count=$((count + 1))
    done
    last=$((FIRST_LOCAL_PORT + count - 1))
    if [ "$last" -gt 65535 ] || { [ "$SOCKS_PORT" -ge "$FIRST_LOCAL_PORT" ] && [ "$SOCKS_PORT" -le "$last" ]; }; then
        echo "nbk: the local ports $FIRST_LOCAL_PORT to $last must be valid and must not include SOCKS_PORT"; return 1
    fi
    if [ -n "$HOSTS" ]; then
        printf '%s\n' "$HOSTS" | tr ';' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' |
        while IFS= read -r line; do
            # shellcheck disable=SC2086
            set -- $line
            if ! is_address "$1" || [ $# -lt 2 ]; then echo bad; break; fi
            shift
            for name in "$@"; do
                printf '%s\n' "$name" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$' || { echo bad; break; }
            done
        done | grep -q bad && { echo "nbk: HOSTS entries must be 'IP name [name ...]' separated by ';'"; return 1; }
    fi
    return 0
}

# --- settings left on the Kindle's storage -----------------------------------------------------

# The folder a computer sees over USB is the only way in for someone without a root shell, and
# anything can write there. So a settings file from it is never run as shell: every line must
# be a comment or one known setting with a plain value, the result must pass the same checks
# as always, and only then does a fresh copy replace the settings in use.
SETTING='(MANAGEMENT_URL|PEER_NAME|FORWARDS|HOSTS|SOCKS_PORT|FIRST_LOCAL_PORT)'
PLAIN_LINE="^${SETTING}=(\"[A-Za-z0-9 .:;/_~-]*\"|[A-Za-z0-9.:/_-]*)[[:space:]]*\$"

# first FOLDER NAME: print the file called NAME or NAME.txt (editors add the ending unasked).
first() {
    for candidate in "$1/$2" "$1/$2.txt"; do
        [ -f "$candidate" ] && { echo "$candidate"; return 0; }
    done
    return 1
}

# Sets TOOK when something was taken in. Fails, changing nothing, when a file is refused.
import() {
    TOOK=""
    if dropped=$(first "$DROP" netbird-kindle.conf); then
        new="$CONF.new"
        text() { tr -d '\r\357\273\277' < "$dropped"; }
        line=$(text | grep -Evn -e '^[[:space:]]*(#.*)?$' -e "$PLAIN_LINE" | head -n 1 | cut -d: -f1)
        if [ -n "$line" ]; then
            echo "nbk: settings file, line $line: not a setting I know. Nothing changed."
            return 1
        fi
        ( umask 077; text | grep -E "$PLAIN_LINE" | sed 's/[[:space:]]*$//' > "$new" ) || { rm -f "$new"; return 1; }
        # shellcheck disable=SC1090
        if ! why=$(. "$new" && defaults && validate); then
            rm -f "$new"
            # the reason goes last: the home-screen item shows only the last line
            echo "nbk: the settings file was not taken. Nothing changed."
            echo "$why"
            return 1
        fi
        mv "$new" "$CONF" && rm -f "$dropped" || { rm -f "$new"; echo "nbk: could not store the settings"; return 1; }
        echo "nbk: took the new settings"
        TOOK=yes
    fi
    if dropped=$(first "$DROP" setup-key) && [ -s "$dropped" ]; then
        ( umask 077; tr -d ' \t\r\n' < "$dropped" > "$KEYFILE" ) && rm -f "$dropped" ||
            { echo "nbk: could not store the setup key"; return 1; }
        echo "nbk: took the setup key"
        TOOK=yes
    fi
    return 0
}

# --- processes ------------------------------------------------------------------------------

# alive NAME: the pid file names a process that is really our binary of that name.
alive() {
    pid=$(cat "$RUN/$1.pid" 2>/dev/null) || return 1
    case "$pid" in '' | *[!0-9]*) return 1 ;; esac
    [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$DIR/$1" ]
}

# end NAME: ask it to stop, wait for it to be gone, insist if it will not go.
end() {
    if alive "$1"; then
        pid=$(cat "$RUN/$1.pid")
        kill "$pid" 2>/dev/null
        waited=0
        while alive "$1" && [ $waited -lt 10 ]; do sleep 1; waited=$((waited + 1)); done
        alive "$1" && kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$RUN/$1.pid"
}

# One nbk at a time: a tap on the home screen and the reader's start hook can arrive together.
lock() {
    mkdir -p "$RUN"
    if ! mkdir "$RUN/lock" 2>/dev/null; then
        holder=$(cat "$RUN/lock/pid" 2>/dev/null)
        if [ -z "$holder" ]; then
            sleep 1 # the other nbk may be between making the lock and signing it
            holder=$(cat "$RUN/lock/pid" 2>/dev/null)
        fi
        # a holder that is gone, or whose number now belongs to something else, left a stale lock
        if [ -n "$holder" ] && tr '\0' ' ' < "/proc/$holder/cmdline" 2>/dev/null | grep -q "nbk"; then
            echo "nbk: another nbk is working"
            exit 3
        fi
        rm -rf "$RUN/lock"
        mkdir "$RUN/lock" || exit 3
    fi
    echo $$ > "$RUN/lock/pid"
    trap 'rm -rf "$RUN/lock"' EXIT
}

# --- firewall and names ---------------------------------------------------------------------

# Print "IP PORT LOCALPORT" for every forward.
forwards() {
    n=$FIRST_LOCAL_PORT
    for f in $FORWARDS; do
        echo "${f%:*} ${f##*:} $n"
        n=$((n + 1))
    done
}

rules_down() {
    while iptables -t nat -D OUTPUT -j $NAT_CHAIN 2>/dev/null; do :; done
    iptables -t nat -F $NAT_CHAIN 2>/dev/null
    iptables -t nat -X $NAT_CHAIN 2>/dev/null
    while iptables -D INPUT -j $IN_CHAIN 2>/dev/null; do :; done
    iptables -F $IN_CHAIN 2>/dev/null
    iptables -X $IN_CHAIN 2>/dev/null
    return 0
}

rules_up() {
    rules_down
    iptables -t nat -N $NAT_CHAIN || return 1
    iptables -N $IN_CHAIN || return 1
    forwards | while read -r ip port local; do
        iptables -t nat -A $NAT_CHAIN -p tcp -d "$ip" --dport "$port" -j REDIRECT --to-ports "$local" || exit 1
        iptables -A $IN_CHAIN -i lo -p tcp --dport "$local" -j ACCEPT || exit 1
        iptables -A $IN_CHAIN ! -i lo -p tcp --dport "$local" -j DROP || exit 1
    done || return 1
    # The Kindle's INPUT chain drops by default and admits loopback only from 127.0.0.1. On a
    # redirected connection the replies arrive on lo carrying the mesh address as their source,
    # so replies of connections this device opened need a rule of their own.
    iptables -A $IN_CHAIN -i lo -p tcp -m state --state RELATED,ESTABLISHED -j ACCEPT || return 1
    # The proxy is for this device only, whatever else is done to the firewall later.
    iptables -A $IN_CHAIN ! -i lo -p tcp --dport "$SOCKS_PORT" -j DROP || return 1
    iptables -t nat -A OUTPUT -j $NAT_CHAIN || return 1
    iptables -I INPUT 1 -j $IN_CHAIN
}

hosts_mounted() { grep -q " /etc/hosts " /proc/mounts 2>/dev/null; }

hosts_down() {
    [ -e "$RUN/hosts.mounted" ] || return 0
    tries=0
    while hosts_mounted && [ $tries -lt 4 ]; do
        umount /etc/hosts 2>/dev/null
        tries=$((tries + 1))
    done
    if hosts_mounted; then
        echo "nbk: could not remove the hosts overlay; a reboot will"
    else
        rm -f "$RUN/hosts.mounted" "$RUN/hosts"
    fi
}

hosts_up() {
    hosts_down
    [ -n "$HOSTS" ] || return 0
    # something else has put a file over /etc/hosts: leave it alone
    hosts_mounted && return 1
    {
        cat /etc/hosts
        echo "# netbird-kindle"
        printf '%s\n' "$HOSTS" | tr ';' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$'
    } > "$RUN/hosts"
    # the marker goes down first: if nbk dies right here, the next run still knows to clean up
    : > "$RUN/hosts.mounted"
    mount -o bind "$RUN/hosts" /etc/hosts
}

# --- the link ---------------------------------------------------------------------------------

first_target() {
    # shellcheck disable=SC2086
    set -- $FORWARDS
    echo "$1"
}

# The whole path, in two steps. A plain connection to the target shows the firewall redirect and
# the forwarder behind it are there. The probe shows the target answers through the mesh.
answers() {
    alive nblink &&
        "$DIR/nblink" -dial "$(first_target)" -timeout 5s 2>/dev/null &&
        "$DIR/nblink" -socks "127.0.0.1:$SOCKS_PORT" -probe "$(first_target)" -timeout 5s 2>/dev/null
}

down() {
    rules_down
    hosts_down
    end nblink
    end netbird
    rm -f "$RUN/netbird.fifo"
}

start() {
    validate || return 2
    mkdir -p "$RUN" "$DIR/state"
    chmod 700 "$DIR" "$DIR/state" 2>/dev/null
    if alive netbird && alive nblink; then
        echo "nbk: already running"
        return 0
    fi
    down
    if [ ! -s "$DIR/state/config.json" ] && [ ! -s "$KEYFILE" ]; then
        echo "nbk: not enrolled yet. Put a file called setup-key in the netbird-kindle folder on the Kindle's storage."
        return 2
    fi

    set -- up --foreground-mode --config "$DIR/state/config.json" --hostname "$PEER_NAME" \
        --log-file console --disable-dns --disable-server-routes --block-inbound
    [ -n "$MANAGEMENT_URL" ] && set -- "$@" --management-url "$MANAGEMENT_URL"
    [ -s "$KEYFILE" ] && set -- "$@" --setup-key-file "$KEYFILE"

    # NetBird's output goes through a pipe to a size-capped file on tmpfs: the Kindle has no
    # log rotation and its writable partitions are small. Neither background process keeps
    # nbk's own output open, or whoever is reading it (the home-screen item) would wait for ever.
    mkfifo "$RUN/netbird.fifo" || return 1
    nohup "$DIR/nblink" -capture "$RUN/netbird.log" -max "$LOG_MAX" \
        < "$RUN/netbird.fifo" > /dev/null 2>&1 &
    NB_USE_NETSTACK_MODE=true NB_SOCKS5_LISTENER_PORT="$SOCKS_PORT" NB_STATE_DIR="$DIR/state" \
        HOME="$DIR/state" nohup "$DIR/netbird" "$@" > "$RUN/netbird.fifo" 2>&1 < /dev/null &
    echo $! > "$RUN/netbird.pid"

    args=""
    for line in $(forwards | tr ' ' ','); do
        ip=${line%%,*}; rest=${line#*,}; port=${rest%%,*}; local=${rest#*,}
        args="$args -forward 127.0.0.1:$local=$ip:$port"
    done
    # shellcheck disable=SC2086
    nohup "$DIR/nblink" -socks "127.0.0.1:$SOCKS_PORT" -log "$RUN/nblink.log" -max "$LOG_MAX" \
        $args > /dev/null 2>&1 < /dev/null &
    echo $! > "$RUN/nblink.pid"

    rules_up || { echo "nbk: could not set the firewall rules"; down; return 1; }
    hosts_up || echo "nbk: could not overlay /etc/hosts; names in HOSTS will not resolve"

    # "Up" means the first forward answers through the redirect and the mesh, not merely that a
    # process runs.
    deadline=$(($(date +%s) + WAIT_SECONDS))
    while [ "$(date +%s)" -lt "$deadline" ] && alive netbird; do
        if answers; then
            # the setup key has done its job: the peer has its own identity now
            rm -f "$KEYFILE"
            echo "nbk: up"
            return 0
        fi
        sleep 2
    done
    if ! alive netbird; then
        echo "nbk: NetBird stopped; see $RUN/netbird.log"
        down
        return 1
    fi
    if ! alive nblink; then
        echo "nbk: the forwarder stopped; see $RUN/nblink.log"
        down
        return 1
    fi
    echo "nbk: started, but $(first_target) does not answer yet (no network, or this peer may not reach it)"
    [ -s "$KEYFILE" ] && echo "nbk: the setup key was kept in $KEYFILE"
    return 1
}

stop() {
    down
    echo "nbk: down"
}

status() {
    for p in netbird nblink; do
        if alive $p; then echo "$p: running (pid $(cat "$RUN/$p.pid"))"; else echo "$p: not running"; fi
    done
    if iptables -t nat -L $NAT_CHAIN -n > /dev/null 2>&1; then
        forwards | while read -r ip port local; do echo "redirect: $ip:$port -> 127.0.0.1:$local"; done
    else
        echo "redirect: none"
    fi
    if [ -e "$RUN/hosts.mounted" ] && hosts_mounted; then echo "hosts: overlay in place"; else echo "hosts: stock"; fi
    if alive netbird && answers; then echo "link: $(first_target) answers"; else echo "link: not answering"; fi
}

case "${1:-status}" in
    start) lock; import || exit 2; need_settings; [ -n "$TOOK" ] && down; start ;;
    # `nbk stop` works without settings, so a half-removed install can still be cleaned up
    stop) lock; settings; stop ;;
    restart) lock; import || exit 2; need_settings; down; start ;;
    status) need_settings; status ;;
    toggle)
        lock; import || exit 2; need_settings
        # new settings or a new key mean "use them", whatever the link was doing
        if [ -n "$TOOK" ]; then down; start; elif alive netbird; then stop; else start; fi
        ;;
    check) need_settings; validate && echo "nbk: settings look right" ;;
    import) lock; import || exit 2; [ -n "$TOOK" ] || echo "nbk: nothing to take in from $DROP" ;;
    *) echo "usage: nbk start|stop|restart|status|toggle|check|import"; exit 2 ;;
esac
